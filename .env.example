# GEMINI_API_KEY: Required for live Gemini AI analysis and AI Decoy responses.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external integration adapters (when unset, ScamSentry runs in clearly labeled DEMO MODE)
AGORA_APP_ID=""
MURF_API_KEY=""
FIREBASE_PROJECT_ID=""
